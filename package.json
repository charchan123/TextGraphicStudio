    "test:browser:phase2": "node scripts/phase2-browser-check.mjs",
    "test:browser:phase25": "node scripts/phase25-browser-check.mjs",
    "test:browser:phase26": "node scripts/phase26-browser-check.mjs && node scripts/phase26-svg-check.mjs",
    "test:browser:phase27": "node scripts/phase27-browser-check.mjs",
    "test:browser:phase28": "node scripts/phase28-browser-check.mjs",
    "test:browser:phase281": "node scripts/phase281-browser-check.mjs",
    "test:browser:phase29": "node scripts/phase29-browser-check.mjs",
    "test:browser:phase30": "node scripts/phase30-browser-check.mjs",
    "test:logic:phase305": "node scripts/phase305-logic-check.mjs",
    "test:logic:phase307": "node scripts/phase307-logic-check.mjs",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fabric": "^7.4.0",
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
